{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "name": "io.github.aplaceforallmystuff/mcp-arr",
  "description": "MCP server for *arr media suite - Sonarr, Radarr, Lidarr, Prowlarr",
  "repository": {
    "url": "https://github.com/aplaceforallmystuff/mcp-arr",
    "source": "github"
  },
  "version": "1.9.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "mcp-arr-server",
      "version": "1.9.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Sonarr server URL",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "SONARR_URL"
        },
        {
          "description": "Sonarr API key",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "SONARR_API_KEY"
        },
        {
          "description": "Radarr server URL",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "RADARR_URL"
        },
        {
          "description": "Radarr API key",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "RADARR_API_KEY"
        },
        {
          "description": "Lidarr server URL",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "LIDARR_URL"
        },
        {
          "description": "Lidarr API key",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "LIDARR_API_KEY"
        },
        {
          "description": "Prowlarr server URL",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "PROWLARR_URL"
        },
        {
          "description": "Prowlarr API key",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "PROWLARR_API_KEY"
        },
        {
          "description": "Bazarr server URL",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "BAZARR_URL"
        },
        {
          "description": "Bazarr API key",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "BAZARR_API_KEY"
        },
        {
          "description": "Maintainerr server URL",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "MAINTAINERR_URL"
        },
        {
          "description": "Maintainerr API key",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "MAINTAINERR_API_KEY"
        },
        {
          "description": "Tdarr server URL",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "TDARR_URL"
        },
        {
          "description": "Tdarr API key (only when authentication is on in Tdarr)",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "TDARR_API_KEY"
        },
        {
          "description": "Plex Media Server URL",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "PLEX_URL"
        },
        {
          "description": "Plex token (X-Plex-Token)",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "PLEX_TOKEN"
        },
        {
          "description": "qBittorrent WebUI URL",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "QBITTORRENT_URL"
        },
        {
          "description": "qBittorrent WebUI username",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "QBITTORRENT_USERNAME"
        },
        {
          "description": "qBittorrent WebUI password",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "QBITTORRENT_PASSWORD"
        },
        {
          "description": "qBittorrent API key (qBittorrent 5.2+, instead of username/password)",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "QBITTORRENT_API_KEY"
        },
        {
          "description": "SABnzbd server URL",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "SABNZBD_URL"
        },
        {
          "description": "SABnzbd API key",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "SABNZBD_API_KEY"
        },
        {
          "description": "Set to true to hide and block every tool that changes state",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "ARR_READ_ONLY"
        }
      ]
    }
  ]
}
